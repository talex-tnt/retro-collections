rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /{path=**}/items/{itemId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.admin == true;
    }

    function isEnabled() {
      return isAuthenticated() && request.auth.token.enabled == true;
    }

    function hasTesterClaim() {
      return isAuthenticated() &&
        ('tester' in request.auth.token) &&
        request.auth.token.tester == true;
    }

    function isTester() {
      return isEnabled() && hasTesterClaim();
    }

    function isUser() {
      return isEnabled() && !hasTesterClaim();
    }

    function canAccessEnvironment(env) {
      return isAdmin() ||
        (env == 'main' && isUser()) ||
        (env == 'test' && isTester());
    }

    function isOwner(data, field) {
      return isAuthenticated() && (field in data) && request.auth.uid == data[field];
    }

    function hasOnlyValidKeys(data, validKeys) { 
      return data.keys().hasOnly(validKeys);
    }
    function hasAllRequiredKeys(data, requiredKeys) {
      return data.keys().hasAll(requiredKeys);
    }
    function hasOnlyAffectedKeys(newData, existingData, validKeys) {
      return newData.diff(existingData).affectedKeys().hasOnly(validKeys);
    }
    function hasAllRequiredAffectedKeys(newData, existingData, requiredKeys) {
      return newData.diff(existingData).affectedKeys().hasAll(requiredKeys);
    }

    function validString(field, maxLength) {
      return field is string && field.size() > 0 && field.size() <= maxLength;
    }

    function validOptionalString(field, maxLength) {
      return field == null || (field is string && field.size() <= maxLength);
    }

    function hasValidOptionalString(data, field, maxLength) {
      return !(field in data) || data[field] == null || validOptionalString(data[field], maxLength);
    }

    function validInteger(field, minVal, maxVal) {
      return field is int && field >= minVal && field <= maxVal;
    }

    function validOptionalInteger(field, minVal, maxVal) {
      return field == null || (field is int && field >= minVal && field <= maxVal);
    }

    function hasValidOptionalInteger(data, field, minVal, maxVal) {
      return !(field in data) || data[field] == null || validOptionalInteger(data[field], minVal, maxVal);
    }

    function validTimestamp(field) {
      return field is timestamp && (
        field == request.time || 
        (field.toMillis() > 0 && field.toMillis() < request.time.toMillis() + 60000)
      );
    }

    function tokenEmail() {
      return isAuthenticated() &&
            ('email' in request.auth.token) && request.auth.token.email is string
        ? request.auth.token.email
        : isAuthenticated() &&
          ('authEmail' in request.auth.token) && request.auth.token.authEmail is string
        ? request.auth.token.authEmail
        : null;
    }

    function isPubliclyVisible() {
      return resource != null &&
        resource.data != null &&
        ('visibility' in resource.data) &&
        (resource.data.visibility is map) &&
        ('public' in resource.data.visibility) &&
        resource.data.visibility.public == true;
    }

    function isValidVisibilityMap(data) {
      return (data is map) &&
        data.keys().hasOnly(['public']) &&
        ('public' in data) &&
        data.public is bool;
    }
    function isValidVisibilityMapOptional(data) {
      return !('visibility' in data) || data.visibility == null || isValidVisibilityMap(data.visibility);
    }
   
 

    // WIP:
    // function getLengthLimitUser(field) {
    //     return (field == 'name') ? 100 :
    //            (field == 'description') ? 1000 : 0;
    // }

    // function createUserKeys() {
    //     return ['name', 'createdAt', 'visibility', 'nickname'];
    // }
    // function createUserRequiredKeys() {
    //   return ['name', 'createdAt', 'visibility', 'nickname'];
    // }
    // function validUserCreate(data) {
    //   return 
    //     isAdmin() ||
    //     (
    //       isAuthenticated() &&
    //       hasOnlyValidKeys(data, createUserKeys()) &&
    //       hasAllRequiredKeys(data, createUserRequiredKeys()) &&
    //       validString(data.name, getLengthLimitUser('name')) &&
    //       validTimestamp(data.createdAt) &&
    //       isValidVisibilityMap(data.visibility) &&
    //       hasValidOptionalString(data, 'description', getLengthLimitUser('description'))
    //     );
    // }

    match /{env}/config/public/runtime {
      allow read: if canAccessEnvironment(env); // Tests 3.1.5-3.1.9: environment gate
      allow write: if canAccessEnvironment(env) && isAdmin(); // Tests 3.1.3, 3.1.4, 3.1.5-3.1.9
    }

    match /{env}/config/{document=**} {
      allow read, write: if canAccessEnvironment(env) && isAdmin(); // Tests 3.1.3, 3.1.4, 3.1.5-3.1.9
    }

    // Admin-only scratch area for tests and diagnostics - Tests 3.1.1, 3.1.2
    match /test/testData/{document=**} {
      allow read, write: if isAdmin();
    }

    match /{env}/data/{folder} {
      allow read, list, write: if canAccessEnvironment(env) && isAdmin(); // Tests 3.1.5-3.1.9: env gate; admin-only on folder doc

      function environmentAccessAllowed() {
        return canAccessEnvironment(env);
      }
      
      function folderMatchesConfig() {
        return get(/databases/$(database)/documents/$(env)/config/public/runtime).data.dataFolder == folder;
      }

      match /private/authorized-users/{email} {
        allow get: if 
          environmentAccessAllowed() && folderMatchesConfig() && (
          isAdmin() || 
          (
            isAuthenticated() && 
            tokenEmail() == email 
          ));
        allow list: if environmentAccessAllowed() && folderMatchesConfig() && isAdmin();
        allow write: if environmentAccessAllowed() && folderMatchesConfig() && isAdmin();
      }

      // Access requests submitted via backend API; collection is private and sibling to authorized-users.
      match /private/users-access-requests/{requestUid} {
        allow get: if
          folderMatchesConfig() && (
          isAdmin() ||
          (
            env == 'main' &&
            isAuthenticated() &&
            request.auth.uid == requestUid
          ));
        allow list: if environmentAccessAllowed() && folderMatchesConfig() && isAdmin();
        allow create, update, delete: if environmentAccessAllowed() && folderMatchesConfig() && isAdmin();
      }

      // users public profile: owner writes only name + visibility.public; others may read only when public - Tests 0.1.1-0.4.4
      match /public/users/{userId} {
        function isUserOwner() {
          return isOwner({'userId': userId}, 'userId');
        }
        // Used indirectly by tests: 0.4.1 (nickname set and update), 0.4.4 (nickname with visibility)
        function hasValidNickname(data) {
          return ('nickname' in data) && validString(data.nickname, 50);
        }

        // Used indirectly by tests: 0.4.1-0.4.2 (user nickname optional/validation), 0.4.4 (visibility without nickname)
        function hasValidOptionalNickname(data) {
          return !('nickname' in data) || data.nickname == null || hasValidNickname(data);
        }

         // Used indirectly by tests: 0.4.4 (nickname required when public)
        function isPublicVisibilityEnabled(data) {
          return ('visibility' in data) &&
            isValidVisibilityMap(data.visibility) &&
            data.visibility.public == true;
        }

        function isValidPublicUserData(data) {
          return 
            data.keys().hasOnly(['name', 'visibility', 'nickname']) && // Tests 0.1.1, 0.1.2: Only allowed fields
            validString(data.name, 100) && // Test 0.1.1: Name required and max 100
            isValidVisibilityMapOptional(data) && // Tests 0.1.1, 0.2.2: Visibility validation
            hasValidOptionalNickname(data) && // Tests 0.4.1, 0.4.2: Nickname optional but valid if present
            (!isPublicVisibilityEnabled(data) || hasValidNickname(data)); // Test 0.4.4: Nickname required if public
        }

        // Test 0.1.1, 0.1.2, 0.2.1: Get (admin, owner, or public)
        allow get: if 
          environmentAccessAllowed() && (
          isAdmin() || // Test 0.1.1
          (
            folderMatchesConfig() && // Test 0.1.3
            (isUserOwner() || isPubliclyVisible()) // Test 0.1.1, 0.2.1
          ));
        // Test 0.2.1, 0.2.3: List only public users
        allow list: if 
          environmentAccessAllowed() && (
          isAdmin() || // Test 0.2.3
          (
            folderMatchesConfig() && // Test 0.2.3
            isPubliclyVisible() // Test 0.2.3
          ));
        // Test 0.1.1, 0.1.2: Create with validation
        allow create: if 
          environmentAccessAllowed() && (
          isAdmin() || // Test 0.1.1
          (
            folderMatchesConfig() && // Test 0.1.3
            isUserOwner() && // Test 0.1.2
            isValidPublicUserData(request.resource.data) // Test 0.1.1, 0.4.1-0.4.4
          ));
        // Test 0.1.1, 0.1.2, 0.2.2: Update with validation
        allow update: if 
          environmentAccessAllowed() && (
          isAdmin() || // Test 0.1.1
          (
            folderMatchesConfig() && // Test 0.1.3
            isUserOwner() && // Test 0.1.2
            isValidPublicUserData(request.resource.data) // Test 0.1.1, 0.2.2, 0.4.1-0.4.4
          ));
        // Test 0.1.4: Delete is admin-only
        allow delete: if environmentAccessAllowed() && isAdmin();
      }

      // users private profile: owner-only read/write for email + lastLogin - Tests 0.3.1, 0.3.2
      match /private/users/{userId} {
         function isUserOwner() {
          return isOwner({'userId': userId}, 'userId');
        }

        function isValidPrivateUserData(data) {
          return 
            data.keys().hasOnly(['email', 'lastLogin']) && // Test 0.3.1: Only allowed fields
            validOptionalString(data.email, 100) && // Test 0.3.1: Email optional, max 100
            validTimestamp(data.lastLogin); // Test 0.3.1: LastLogin must be valid timestamp
        }

        // Test 0.3.1, 0.3.2: Owner-only get
        allow get: if 
          environmentAccessAllowed() && (
          isAdmin() || // Test 0.3.1
          (
            folderMatchesConfig() && // Test 0.3.2
            isUserOwner() // Test 0.3.2
          ));
        // Test 0.3.1: Admin list only
        allow list: if environmentAccessAllowed() && isAdmin();
        // Test 0.3.1, 0.3.2: Owner-only create with validation
        allow create: if 
          environmentAccessAllowed() && (
          isAdmin() || // Test 0.3.1
          (
            isUserOwner() && // Test 0.3.2
            folderMatchesConfig() && // Test 0.3.2
            isValidPrivateUserData(request.resource.data) // Test 0.3.1
          ));
        // Test 0.3.1, 0.3.2: Owner-only update with validation
        allow update: if 
          environmentAccessAllowed() && (
          isAdmin() || // Test 0.3.1
          (
            isUserOwner() && // Test 0.3.2
            folderMatchesConfig() && // Test 0.3.2
            isValidPrivateUserData(request.resource.data) // Test 0.3.1
          ));
        // Test 0.3.1: Admin-only delete
        allow delete: if environmentAccessAllowed() && isAdmin();
      }


      // Items are now stored directly under the user document (no collections)
      match /public/users/{userId}/items/{itemId} {
        function isUserOwner() {
          return isOwner({'userId': userId}, 'userId');
        }
        // ----------------------------------------------------------------
        // items helpers -----------------------------------------------
        function getLengthLimit(field) {
          return (field == 'item.name') ? 100 :
                (field == 'item.description') ? 1000 : 0;
        }
        function createKeys() {
          return ['name', 'nameLowercase', 'nameTokens', 'createdAt', 'updatedAt', 'description', 'tags', 'metadata', 'userId', 'isPublic'];
        }
        function createRequiredKeys() {
          return ['name', 'nameLowercase', 'nameTokens', 'createdAt', 'userId', 'isPublic'];
        }
        function validCreate(data) {
          return 
            (
              isAuthenticated() &&
              hasOnlyValidKeys(data, createKeys()) &&
              hasAllRequiredKeys(data, createRequiredKeys()) &&
              isUserOwner() && isOwner(data, 'userId') &&
              data.isPublic is bool && data.isPublic == true &&
              validString(data.name, getLengthLimit('item.name')) &&
              validTimestamp(data.createdAt) &&
              hasValidOptionalString(data, 'description', getLengthLimit('item.description'))
            );
        }
        function updateKeys() {
          return ['name', 'nameLowercase', 'nameTokens', 'updatedAt', 'description', 'tags', 'metadata', 'userId'];
        }
        function updateRequiredKeys() {
          return ['updatedAt'];
        }
        function validUpdate(newData, existingData) {
          return 
            (
              isAuthenticated() &&
              existingData != null &&
              hasOnlyAffectedKeys(newData, existingData, updateKeys()) &&
              hasAllRequiredAffectedKeys(newData, existingData, updateRequiredKeys()) &&
              isUserOwner() &&
              newData.createdAt == existingData.createdAt &&
              newData.userId == existingData.userId &&
              ('isPublic' in newData) &&
              (newData.isPublic is bool) &&
              newData.isPublic == true &&
              newData.isPublic == existingData.isPublic &&
              validTimestamp(newData.updatedAt) &&
              hasValidOptionalString(newData, 'name', getLengthLimit('item.name')) &&
              hasValidOptionalString(newData, 'description', getLengthLimit('item.description'))
            );
        }

       
        allow get: if  // public
          environmentAccessAllowed() 
          && folderMatchesConfig(); 
       
        allow list: if //public
          environmentAccessAllowed() 
          && folderMatchesConfig();
        

        allow create: if // owner or admin
          environmentAccessAllowed() 
          && folderMatchesConfig() 
          && validCreate(request.resource.data)
          && (isAdmin() || isUserOwner());
        
        allow update: if 
          environmentAccessAllowed() 
          && folderMatchesConfig() 
          && validUpdate(request.resource.data, resource.data)
          && (isAdmin() || isUserOwner());
        
        allow delete: if 
          environmentAccessAllowed() 
          && folderMatchesConfig()
          && (isAdmin() || isUserOwner());

      }


      match /public/users/{userId}/tags/{tagId} {
        function isUserOwner() {
          return isOwner({'userId': userId}, 'userId');
        }
        // ----------------------------------------------------------------
        // Tags helpers -----------------------------------------------
        function getLengthLimitTag(field) {
          return (field == 'tag.name') ? 100 :
                (field == 'tag.description') ? 1000 : 0;
        }
        function createTagKeys() {
          return ['name', 'createdAt', 'updatedAt', 'description', 'style', 'order', 'priority'];
        }
        function createTagRequiredKeys() {
          return ['createdAt'];
        }
        function validTagCreate(data) {
          return 
            (
              isAuthenticated() &&
              hasOnlyValidKeys(data, createTagKeys()) &&
              hasAllRequiredKeys(data, createTagRequiredKeys()) &&
              isOwner({ 'userId': userId }, 'userId') &&
              validTimestamp(data.createdAt) &&
              hasValidOptionalString(data, 'name', getLengthLimitTag('tag.name')) &&
              hasValidOptionalString(data, 'description', getLengthLimitTag('tag.description')) &&
              hasValidOptionalInteger(data, 'order', -1000000, 1000000) &&
              hasValidOptionalInteger(data, 'priority', -1000000, 1000000)
            );
        }
        function validOptionalStyle(data) {
          return !('style' in data) || data.style == null || (
            data.style is map &&
            data.style.keys().hasOnly(['backgroundColor', 'foregroundColor', 'imageUrl']) &&
            (!('backgroundColor' in data.style) || data.style.backgroundColor == null || (data.style.backgroundColor is string && data.style.backgroundColor.size() > 0 && data.style.backgroundColor.size() <= 50)) &&
            (!('foregroundColor' in data.style) || data.style.foregroundColor == null || (data.style.foregroundColor is string && data.style.foregroundColor.size() > 0 && data.style.foregroundColor.size() <= 50))
          );
        }
        function updateTagKeys() {
          return ['name', 'updatedAt', 'createdAt', 'description', 'style', 'order', 'priority'];
        }
        function updateTagRequiredKeys() {
          return ['updatedAt'];
        }
        function validTagUpdate(newData, existingData) {
          return 
            (
              isAuthenticated() &&
              existingData != null &&
              hasOnlyAffectedKeys(newData, existingData, updateTagKeys()) &&
              hasAllRequiredAffectedKeys(newData, existingData, updateTagRequiredKeys()) &&
              isOwner( { 'userId': userId }, 'userId') &&
              newData.createdAt == existingData.createdAt &&
              validTimestamp(newData.updatedAt) &&
              hasValidOptionalString(newData, 'name', getLengthLimitTag('tag.name')) &&
              hasValidOptionalString(newData, 'description', getLengthLimitTag('tag.description')) &&
              hasValidOptionalInteger(newData, 'order', -1000000, 1000000) &&
              hasValidOptionalInteger(newData, 'priority', -1000000, 1000000) &&
              validOptionalStyle(newData)
            );
        }

        // Admin, owner, or public
        allow get: if 
          environmentAccessAllowed() 
          && folderMatchesConfig();
        
        allow list: if 
          environmentAccessAllowed() 
          && folderMatchesConfig();
        
        allow create: if 
          environmentAccessAllowed() 
          && folderMatchesConfig() 
          && validTagCreate(request.resource.data)
          && (isAdmin() || isUserOwner());
        
        allow update: if 
          environmentAccessAllowed() 
          && folderMatchesConfig() 
          && validTagUpdate(request.resource.data, resource.data)
          && (isAdmin() || isUserOwner());
        
        allow delete: if 
          environmentAccessAllowed() 
          && folderMatchesConfig()
          && (isAdmin() || isUserOwner());

      }

      match /public/users/{userId}/collections/{collectionId} {
        function isUserOwner() {
          return isOwner({'userId': userId}, 'userId');
        }
        // ----------------------------------------------------------------
        // items helpers -----------------------------------------------
        function getLengthLimit(field) {
          return (field == 'item.name') ? 100 :
                (field == 'item.description') ? 1000 : 0;
        }
        function createKeys() {
          return ['name', 'nameLowercase', 'nameTokens', 'createdAt', 'updatedAt', 'description', 'tags', 'metadata', 'userId'];
        }
        function createRequiredKeys() {
          return ['name', 'nameLowercase', 'nameTokens', 'createdAt', 'userId'];
        }
        function validCreate(data) {
          return 
            (
              isAuthenticated() &&
              hasOnlyValidKeys(data, createKeys()) &&
              hasAllRequiredKeys(data, createRequiredKeys()) &&
              isUserOwner() && isOwner(data, 'userId') &&
              validString(data.name, getLengthLimit('item.name')) &&
              validTimestamp(data.createdAt) &&
              hasValidOptionalString(data, 'description', getLengthLimit('item.description'))
            );
        }
        function updateKeys() {
          return ['name', 'nameLowercase', 'nameTokens', 'updatedAt', 'description', 'tags', 'metadata', 'userId'];
        }
        function updateRequiredKeys() {
          return ['updatedAt'];
        }
        function validUpdate(newData, existingData) {
          return 
            (
              isAuthenticated() &&
              existingData != null &&
              hasOnlyAffectedKeys(newData, existingData, updateKeys()) &&
              hasAllRequiredAffectedKeys(newData, existingData, updateRequiredKeys()) &&
              isUserOwner() &&
              newData.createdAt == existingData.createdAt &&
              newData.userId == existingData.userId &&
              validTimestamp(newData.updatedAt) &&
              hasValidOptionalString(newData, 'name', getLengthLimit('item.name')) &&
              hasValidOptionalString(newData, 'description', getLengthLimit('item.description'))
            );
        }

       
        allow get: if  // public
          environmentAccessAllowed() 
          && folderMatchesConfig(); 
       
        allow list: if //public
          environmentAccessAllowed() 
          && folderMatchesConfig();
        

        allow create: if // owner or admin
          environmentAccessAllowed() 
          && folderMatchesConfig() 
          && validCreate(request.resource.data)
          && (isAdmin() || isUserOwner());
        
        allow update: if 
          environmentAccessAllowed() 
          && folderMatchesConfig() 
          && validUpdate(request.resource.data, resource.data)
          && (isAdmin() || isUserOwner());
        
        allow delete: if 
          environmentAccessAllowed() 
          && folderMatchesConfig()
          && (isAdmin() || isUserOwner());

      }
      match /public/users/{userId}/collections/{collectionId}/items/{itemId} {
        function isUserOwner() {
          return isOwner({'userId': userId}, 'userId');
        }
        // ----------------------------------------------------------------
        // items helpers -----------------------------------------------
        function getLengthLimit(field) {
          return (field == 'item.name') ? 100 :
                (field == 'item.description') ? 1000 : 0;
        }
        function createKeys() {
          return ['name', 'nameLowercase', 'nameTokens', 'createdAt', 'updatedAt', 'description', 'tags', 'metadata', 'userId', 'collectionId', 'isPublic'];
        }
        function createRequiredKeys() {
          return ['name', 'nameLowercase', 'nameTokens', 'createdAt', 'userId', 'collectionId', 'isPublic'];
        }
        function validCreate(data) {
          return 
            (
              isAuthenticated() &&
              hasOnlyValidKeys(data, createKeys()) &&
              hasAllRequiredKeys(data, createRequiredKeys()) &&
              isUserOwner() && isOwner(data, 'userId') &&
              data.isPublic is bool && data.isPublic == true &&
              validString(data.name, getLengthLimit('item.name')) &&
              validTimestamp(data.createdAt) &&
              hasValidOptionalString(data, 'description', getLengthLimit('item.description'))
            );
        }
        function updateKeys() {
          return ['name', 'nameLowercase', 'nameTokens', 'updatedAt', 'description', 'tags', 'metadata', 'userId', 'collectionId'];
        }
        function updateRequiredKeys() {
          return ['updatedAt'];
        }
        function validUpdate(newData, existingData) {
          return 
            (
              isAuthenticated() &&
              existingData != null &&
              hasOnlyAffectedKeys(newData, existingData, updateKeys()) &&
              hasAllRequiredAffectedKeys(newData, existingData, updateRequiredKeys()) &&
              isUserOwner() &&
              newData.createdAt == existingData.createdAt &&
              newData.userId == existingData.userId &&
              ('isPublic' in newData) &&
              (newData.isPublic is bool) &&
              newData.isPublic == true &&
              newData.isPublic == existingData.isPublic &&
              validTimestamp(newData.updatedAt) &&
              hasValidOptionalString(newData, 'name', getLengthLimit('item.name')) &&
              hasValidOptionalString(newData, 'description', getLengthLimit('item.description'))
            );
        }

       
        allow get: if  // public
          environmentAccessAllowed() 
          && folderMatchesConfig(); 
       
        allow list: if //public
          environmentAccessAllowed() 
          && folderMatchesConfig();
        

        allow create: if // owner or admin
          environmentAccessAllowed() 
          && folderMatchesConfig() 
          && validCreate(request.resource.data)
          && (isAdmin() || isUserOwner());
        
        allow update: if 
          environmentAccessAllowed() 
          && folderMatchesConfig() 
          && validUpdate(request.resource.data, resource.data)
          && (isAdmin() || isUserOwner());
        
        allow delete: if 
          environmentAccessAllowed() 
          && folderMatchesConfig()
          && (isAdmin() || isUserOwner());

      }

      match /public/users/{userId}/wishlists/{wishlistId} {
        function isUserOwner() {
          return isOwner({'userId': userId}, 'userId');
        }
        function getLengthLimit(field) {
          return (field == 'item.name') ? 100 :
                (field == 'item.description') ? 1000 : 0;
        }
        function createKeys() {
          return ['name', 'nameLowercase', 'nameTokens', 'createdAt', 'updatedAt', 'description', 'tags', 'metadata', 'userId'];
        }
        function createRequiredKeys() {
          return ['name', 'nameLowercase', 'nameTokens', 'createdAt', 'userId'];
        }
        function validCreate(data) {
          return 
            (
              isAuthenticated() &&
              hasOnlyValidKeys(data, createKeys()) &&
              hasAllRequiredKeys(data, createRequiredKeys()) &&
              isUserOwner() && isOwner(data, 'userId') &&
              validString(data.name, getLengthLimit('item.name')) &&
              validTimestamp(data.createdAt) &&
              hasValidOptionalString(data, 'description', getLengthLimit('item.description'))
            );
        }
        function updateKeys() {
          return ['name', 'nameLowercase', 'nameTokens', 'updatedAt', 'description', 'tags', 'metadata', 'userId'];
        }
        function updateRequiredKeys() {
          return ['updatedAt'];
        }
        function validUpdate(newData, existingData) {
          return 
            (
              isAuthenticated() &&
              existingData != null &&
              hasOnlyAffectedKeys(newData, existingData, updateKeys()) &&
              hasAllRequiredAffectedKeys(newData, existingData, updateRequiredKeys()) &&
              isUserOwner() &&
              newData.createdAt == existingData.createdAt &&
              newData.userId == existingData.userId &&
              validTimestamp(newData.updatedAt) &&
              hasValidOptionalString(newData, 'name', getLengthLimit('item.name')) &&
              hasValidOptionalString(newData, 'description', getLengthLimit('item.description'))
            );
        }

        allow get: if
          environmentAccessAllowed()
          && folderMatchesConfig();

        allow list: if
          environmentAccessAllowed()
          && folderMatchesConfig();

        allow create: if
          environmentAccessAllowed()
          && folderMatchesConfig()
          && validCreate(request.resource.data)
          && (isAdmin() || isUserOwner());

        allow update: if
          environmentAccessAllowed()
          && folderMatchesConfig()
          && validUpdate(request.resource.data, resource.data)
          && (isAdmin() || isUserOwner());

        allow delete: if
          environmentAccessAllowed()
          && folderMatchesConfig()
          && (isAdmin() || isUserOwner());
      }

      match /public/users/{userId}/wishlists/{wishlistId}/wishes/{wishId} {
        function isUserOwner() {
          return isOwner({'userId': userId}, 'userId');
        }
        function getLengthLimit(field) {
          return (field == 'item.name') ? 100 :
                (field == 'item.description') ? 1000 : 0;
        }
        function createKeys() {
          return ['name', 'nameLowercase', 'nameTokens', 'createdAt', 'updatedAt', 'description', 'tags', 'metadata', 'userId', 'wishlistId'];
        }
        function createRequiredKeys() {
          return ['name', 'nameLowercase', 'nameTokens', 'createdAt', 'userId', 'wishlistId'];
        }
        function validCreate(data) {
          return 
            (
              isAuthenticated() &&
              hasOnlyValidKeys(data, createKeys()) &&
              hasAllRequiredKeys(data, createRequiredKeys()) &&
              isUserOwner() && isOwner(data, 'userId') &&
              validString(data.name, getLengthLimit('item.name')) &&
              validTimestamp(data.createdAt) &&
              hasValidOptionalString(data, 'description', getLengthLimit('item.description'))
            );
        }
        function updateKeys() {
          return ['name', 'nameLowercase', 'nameTokens', 'updatedAt', 'description', 'tags', 'metadata', 'userId', 'wishlistId'];
        }
        function updateRequiredKeys() {
          return ['updatedAt'];
        }
        function validUpdate(newData, existingData) {
          return 
            (
              isAuthenticated() &&
              existingData != null &&
              hasOnlyAffectedKeys(newData, existingData, updateKeys()) &&
              hasAllRequiredAffectedKeys(newData, existingData, updateRequiredKeys()) &&
              isUserOwner() &&
              newData.createdAt == existingData.createdAt &&
              newData.userId == existingData.userId &&
              validTimestamp(newData.updatedAt) &&
              hasValidOptionalString(newData, 'name', getLengthLimit('item.name')) &&
              hasValidOptionalString(newData, 'description', getLengthLimit('item.description'))
            );
        }

        allow get: if
          environmentAccessAllowed()
          && folderMatchesConfig();

        allow list: if
          environmentAccessAllowed()
          && folderMatchesConfig();

        allow create: if
          environmentAccessAllowed()
          && folderMatchesConfig()
          && validCreate(request.resource.data)
          && (isAdmin() || isUserOwner());

        allow update: if
          environmentAccessAllowed()
          && folderMatchesConfig()
          && validUpdate(request.resource.data, resource.data)
          && (isAdmin() || isUserOwner());

        allow delete: if
          environmentAccessAllowed()
          && folderMatchesConfig()
          && (isAdmin() || isUserOwner());
      }

      // Nickname index: track nicknames and their owners - Tests 4.1.1-4.1.5
      // Authenticated users can read nickname docs, but can only write/delete if they contain their own userId
      match /public/nicknameIndex/{nickname} {
        // Test 4.1.1: Authenticated users can read
        allow get, list: if 
          environmentAccessAllowed() && (
          isAdmin() || // Test 4.1.5
          (
            folderMatchesConfig() && // Test 4.1.4
            isAuthenticated() // Test 4.1.1
          ));
        // Test 4.1.2: Owner can create with their userId
        allow create: if 
          environmentAccessAllowed() && (
          isAdmin() || // Test 4.1.5
          (
            folderMatchesConfig() && // Test 4.1.4
            isAuthenticated() && // Test 4.1.2
            request.resource.data.userId == request.auth.uid && // Test 4.1.2
            request.resource.data.userId is string // Test 4.1.2
          ));
        // Test 4.1.2, 4.1.3: Owner can update with their userId
        allow update: if 
          environmentAccessAllowed() && (
          isAdmin() || // Test 4.1.5
          (
            folderMatchesConfig() && // Test 4.1.4
            isAuthenticated() && // Test 4.1.3
            resource.data.userId == request.auth.uid && // Test 4.1.3
            request.resource.data.userId == request.auth.uid && // Test 4.1.3
            request.resource.data.userId is string // Test 4.1.3
          ));
        // Test 4.1.3: Owner can delete if they own it
        allow delete: if 
          environmentAccessAllowed() && (
          isAdmin() || // Test 4.1.5
          (
            folderMatchesConfig() && // Test 4.1.4
            isAuthenticated() && // Test 4.1.3
            resource.data.userId == request.auth.uid // Test 4.1.3
          ));
      }

      match /private/users/{userId}/settings/wikipedia {
        function isUserOwner() {
          return isOwner({'userId': userId}, 'userId');
        }

        function isValidSetting(data) {
          return hasOnlyValidKeys(data, ['enableSuggestions']) 
            && ('enableSuggestions' in data) 
            && data.enableSuggestions is bool;
        }
  
        allow read: if 
          environmentAccessAllowed() 
          && folderMatchesConfig()
          && isUserOwner();
        
        allow write: if 
          environmentAccessAllowed() 
          && folderMatchesConfig()
          && isUserOwner()
          && isValidSetting(request.resource.data);
      }
      match /private/users/{userId}/settings/rawg {
        function isUserOwner() {
          return isOwner({'userId': userId}, 'userId');
        }

        function isValidSetting(data) {
          return hasOnlyValidKeys(data, ['enableSuggestions']) 
            && ('enableSuggestions' in data) 
            && data.enableSuggestions is bool;
        }
  
        allow read: if 
          environmentAccessAllowed() 
          && folderMatchesConfig()
          && isUserOwner();
        
        allow write: if 
          environmentAccessAllowed() 
          && folderMatchesConfig()
          && isUserOwner()
          && isValidSetting(request.resource.data);
      }
      match /private/users/{userId}/settings/ui {
        function isUserOwner() {
          return isOwner({'userId': userId}, 'userId');
        }

        function isValidSetting(data) {
          return hasOnlyValidKeys(data, ['collapseImages', 'enableImageProxy', 'defaultListPageSize', 'desktopPreviewImageSize', 'mobilePreviewImageSize']) 
            && ('collapseImages' in data) 
            && data.collapseImages is bool
            && ('enableImageProxy' in data)
            && data.enableImageProxy is bool
            && ('defaultListPageSize' in data)
            && data.defaultListPageSize is int
            && ('desktopPreviewImageSize' in data)
            && data.desktopPreviewImageSize is int
            && ('mobilePreviewImageSize' in data)
            && data.mobilePreviewImageSize is int;
        }
  
        allow read: if 
          environmentAccessAllowed() 
          && folderMatchesConfig()
          && isUserOwner();
        
        allow write: if 
          environmentAccessAllowed() 
          && folderMatchesConfig()
          && isUserOwner()
          && isValidSetting(request.resource.data);
      }

      // AI assistant preferences and provider list (no API keys) - Tests 5.1.1-5.1.8
      match /private/users/{userId}/settings/ai {
        function isUserOwner() {
          return isOwner({'userId': userId}, 'userId');
        }

        function isValidSetting(data) {
          return hasOnlyValidKeys(data, ['keyStorage', 'defaultProviderId', 'providers', 'aiImageMaxSize', 'driveImageMode', 'driveImageMaxSize', 'extraInstructions'])
            && data.keyStorage in ['local', 'account'] // Test 5.1.5
            && data.defaultProviderId is string
            && data.defaultProviderId.size() <= 100
            && data.providers is list
            && data.providers.size() <= 20 // Test 5.1.7
            && data.aiImageMaxSize is int
            && data.aiImageMaxSize >= 256
            && data.aiImageMaxSize <= 4096
            && data.driveImageMode in ['original', 'resized']
            && data.driveImageMaxSize is int
            && data.driveImageMaxSize >= 512
            && data.driveImageMaxSize <= 8192
            && data.extraInstructions is string
            && data.extraInstructions.size() <= 2000; // Test 5.1.8
        }

        allow read: if
          environmentAccessAllowed()
          && folderMatchesConfig()
          && isUserOwner(); // Tests 5.1.2, 5.1.3

        allow write: if
          environmentAccessAllowed()
          && folderMatchesConfig()
          && isUserOwner() // Tests 5.1.1, 5.1.4
          && isValidSetting(request.resource.data); // Tests 5.1.5-5.1.8
      }

      // AI provider API keys, only when the user opts to store them in their account - Tests 5.2.1-5.2.6
      match /private/users/{userId}/settings/aiKeys {
        function isUserOwner() {
          return isOwner({'userId': userId}, 'userId');
        }

        function isValidKeys(data) {
          return hasOnlyValidKeys(data, ['keys']) // Test 5.2.4
            && data.keys is map // Test 5.2.5
            && data.keys.size() <= 20;
        }

        allow read: if
          environmentAccessAllowed()
          && folderMatchesConfig()
          && isUserOwner(); // Tests 5.2.1, 5.2.2, 5.2.6

        allow create, update: if
          environmentAccessAllowed()
          && folderMatchesConfig()
          && isUserOwner() // Test 5.2.1
          && isValidKeys(request.resource.data); // Tests 5.2.4, 5.2.5

        allow delete: if
          environmentAccessAllowed()
          && folderMatchesConfig()
          && isUserOwner(); // Test 5.2.3
      }

      // Items are now stored directly under the user document (no collections)
      match /private/users/{userId}/items/{itemId} {
        function isUserOwner() {
          return isOwner({'userId': userId}, 'userId');
        }
        // ----------------------------------------------------------------
        // items helpers -----------------------------------------------
        function getLengthLimit(field) {
          return (field == 'item.name') ? 100 :
                (field == 'item.description') ? 1000 : 0;
        }
        function createKeys() {
          return ['name', 'nameLowercase', 'nameTokens', 'createdAt', 'updatedAt', 'description', 'tags', 'metadata', 'userId', 'isPublic'];
        }
        function createRequiredKeys() {
          return ['name', 'nameLowercase', 'nameTokens', 'createdAt', 'userId', 'isPublic'];
        }
        function validCreate(data) {
          return 
            (
              isAuthenticated() &&
              hasOnlyValidKeys(data, createKeys()) &&
              hasAllRequiredKeys(data, createRequiredKeys()) &&
              isUserOwner() && isOwner(data, 'userId') &&
              data.isPublic is bool && data.isPublic == false &&
              validString(data.name, getLengthLimit('item.name')) &&
              validTimestamp(data.createdAt) &&
              hasValidOptionalString(data, 'description', getLengthLimit('item.description'))
            );
        }
        function updateKeys() {
          return ['name', 'nameLowercase', 'nameTokens', 'updatedAt', 'description', 'tags', 'metadata', 'userId'];
        }
        function updateRequiredKeys() {
          return ['updatedAt'];
        }
        function validUpdate(newData, existingData) {
          return 
            (
              isAuthenticated() &&
              existingData != null &&
              hasOnlyAffectedKeys(newData, existingData, updateKeys()) &&
              hasAllRequiredAffectedKeys(newData, existingData, updateRequiredKeys()) &&
              isUserOwner() && isOwner(existingData, 'userId') &&
              newData.createdAt == existingData.createdAt &&
              newData.userId == existingData.userId &&
              ('isPublic' in newData) &&
              (newData.isPublic is bool) &&
              newData.isPublic == false &&
              newData.isPublic == existingData.isPublic &&
              validTimestamp(newData.updatedAt) &&
              hasValidOptionalString(newData, 'name', getLengthLimit('item.name')) &&
              hasValidOptionalString(newData, 'description', getLengthLimit('item.description'))
            );
        }

       
        allow get: if  // public
          environmentAccessAllowed() 
          && folderMatchesConfig()
          && (isAdmin() || isUserOwner());
 
       
        allow list: if //public
          environmentAccessAllowed() 
          && folderMatchesConfig()
          && (isAdmin() || isUserOwner());
        

        allow create: if // owner or admin
          environmentAccessAllowed() 
          && folderMatchesConfig() 
          && validCreate(request.resource.data)
          && (isAdmin() || isUserOwner());
        
        allow update: if 
          environmentAccessAllowed() 
          && folderMatchesConfig() 
          && validUpdate(request.resource.data, resource.data)
          && (isAdmin() || isUserOwner());
        
        allow delete: if 
          environmentAccessAllowed() 
          && folderMatchesConfig()
          && (isAdmin() || isUserOwner());

      }
      // Private collections
      match /private/users/{userId}/collections/{collectionId} {
        function isUserOwner() {
          return isOwner({'userId': userId}, 'userId');
        }
        // ----------------------------------------------------------------
        // items helpers -----------------------------------------------
        function getLengthLimit(field) {
          return (field == 'item.name') ? 100 :
                (field == 'item.description') ? 1000 : 0;
        }
        function createKeys() {
          return ['name', 'nameLowercase', 'nameTokens', 'createdAt', 'updatedAt', 'description', 'tags', 'metadata', 'userId'];
        }
        function createRequiredKeys() {
          return ['name', 'nameLowercase', 'nameTokens', 'createdAt', 'userId'];
        }
        function validCreate(data) {
          return 
            (
              isAuthenticated() &&
              hasOnlyValidKeys(data, createKeys()) &&
              hasAllRequiredKeys(data, createRequiredKeys()) &&
              isUserOwner() && isOwner(data, 'userId') &&
              validString(data.name, getLengthLimit('item.name')) &&
              validTimestamp(data.createdAt) &&
              hasValidOptionalString(data, 'description', getLengthLimit('item.description'))
            );
        }
        function updateKeys() {
          return ['name', 'nameLowercase', 'nameTokens', 'updatedAt', 'description', 'tags', 'metadata', 'userId'];
        }
        function updateRequiredKeys() {
          return ['updatedAt'];
        }
        function validUpdate(newData, existingData) {
          return 
            (
              isAuthenticated() &&
              existingData != null &&
              hasOnlyAffectedKeys(newData, existingData, updateKeys()) &&
              hasAllRequiredAffectedKeys(newData, existingData, updateRequiredKeys()) &&
              isUserOwner() && isOwner(existingData, 'userId') &&
              newData.createdAt == existingData.createdAt &&
              newData.userId == existingData.userId &&
              validTimestamp(newData.updatedAt) &&
              hasValidOptionalString(newData, 'name', getLengthLimit('item.name')) &&
              hasValidOptionalString(newData, 'description', getLengthLimit('item.description'))
            );
        }

       
        allow get: if  // public
          environmentAccessAllowed() 
          && folderMatchesConfig()
          && (isAdmin() || isUserOwner());
 
       
        allow list: if //public
          environmentAccessAllowed() 
          && folderMatchesConfig()
          && (isAdmin() || isUserOwner());
        

        allow create: if // owner or admin
          environmentAccessAllowed() 
          && folderMatchesConfig() 
          && validCreate(request.resource.data)
          && (isAdmin() || isUserOwner());
        
        allow update: if 
          environmentAccessAllowed() 
          && folderMatchesConfig() 
          && validUpdate(request.resource.data, resource.data)
          && (isAdmin() || isUserOwner());
        
        allow delete: if 
          environmentAccessAllowed() 
          && folderMatchesConfig()
          && (isAdmin() || isUserOwner());

      }

      // Private collections' items
      match /private/users/{userId}/collections/{collectionId}/items/{itemId} {
        function isUserOwner() {
          return isOwner({'userId': userId}, 'userId');
        }
        // ----------------------------------------------------------------
        // items helpers -----------------------------------------------
        function getLengthLimit(field) {
          return (field == 'item.name') ? 100 :
                (field == 'item.description') ? 1000 : 0;
        }
        function createKeys() {
          return ['name', 'nameLowercase', 'nameTokens', 'createdAt', 'updatedAt', 'description', 'tags', 'metadata', 'userId', 'collectionId', 'isPublic'];
        }
        function createRequiredKeys() {
          return ['name', 'nameLowercase', 'nameTokens', 'createdAt', 'userId', 'collectionId', 'isPublic'];
        }
        function validCreate(data) {
          return 
            (
              isAuthenticated() &&
              hasOnlyValidKeys(data, createKeys()) &&
              hasAllRequiredKeys(data, createRequiredKeys()) &&
              isUserOwner() && isOwner(data, 'userId') &&
              data.isPublic is bool && data.isPublic == false &&
              validString(data.name, getLengthLimit('item.name')) &&
              validTimestamp(data.createdAt) &&
              hasValidOptionalString(data, 'description', getLengthLimit('item.description'))
            );
        }
        function updateKeys() {
          return ['name', 'nameLowercase', 'nameTokens', 'updatedAt', 'description', 'tags', 'metadata', 'userId', 'collectionId'];
        }
        function updateRequiredKeys() {
          return ['updatedAt'];
        }
        function validUpdate(newData, existingData) {
          return 
            (
              isAuthenticated() &&
              existingData != null &&
              hasOnlyAffectedKeys(newData, existingData, updateKeys()) &&
              hasAllRequiredAffectedKeys(newData, existingData, updateRequiredKeys()) &&
              isUserOwner() && isOwner(existingData, 'userId') &&
              newData.createdAt == existingData.createdAt &&
              newData.userId == existingData.userId &&
              ('isPublic' in newData) &&
              (newData.isPublic is bool) &&
              newData.isPublic == false &&
              newData.isPublic == existingData.isPublic &&
              validTimestamp(newData.updatedAt) &&
              hasValidOptionalString(newData, 'name', getLengthLimit('item.name')) &&
              hasValidOptionalString(newData, 'description', getLengthLimit('item.description'))
            );
        }

       
        allow get: if  // public
          environmentAccessAllowed() 
          && folderMatchesConfig()
          && (isAdmin() || isUserOwner());
 
       
        allow list: if //public
          environmentAccessAllowed() 
          && folderMatchesConfig()
          && (isAdmin() || isUserOwner());
        

        allow create: if // owner or admin
          environmentAccessAllowed() 
          && folderMatchesConfig() 
          && validCreate(request.resource.data)
          && (isAdmin() || isUserOwner());
        
        allow update: if 
          environmentAccessAllowed() 
          && folderMatchesConfig() 
          && validUpdate(request.resource.data, resource.data)
          && (isAdmin() || isUserOwner());
        
        allow delete: if 
          environmentAccessAllowed() 
          && folderMatchesConfig()
          && (isAdmin() || isUserOwner());

      }

      // Private wishlists
      match /private/users/{userId}/wishlists/{wishlistId} {
        function isUserOwner() {
          return isOwner({'userId': userId}, 'userId');
        }
        function getLengthLimit(field) {
          return (field == 'item.name') ? 100 :
                (field == 'item.description') ? 1000 : 0;
        }
        function createKeys() {
          return ['name', 'nameLowercase', 'nameTokens', 'createdAt', 'updatedAt', 'description', 'tags', 'metadata', 'userId'];
        }
        function createRequiredKeys() {
          return ['name', 'nameLowercase', 'nameTokens', 'createdAt', 'userId'];
        }
        function validCreate(data) {
          return 
            (
              isAuthenticated() &&
              hasOnlyValidKeys(data, createKeys()) &&
              hasAllRequiredKeys(data, createRequiredKeys()) &&
              isUserOwner() && isOwner(data, 'userId') &&
              validString(data.name, getLengthLimit('item.name')) &&
              validTimestamp(data.createdAt) &&
              hasValidOptionalString(data, 'description', getLengthLimit('item.description'))
            );
        }
        function updateKeys() {
          return ['name', 'nameLowercase', 'nameTokens', 'updatedAt', 'description', 'tags', 'metadata', 'userId'];
        }
        function updateRequiredKeys() {
          return ['updatedAt'];
        }
        function validUpdate(newData, existingData) {
          return 
            (
              isAuthenticated() &&
              existingData != null &&
              hasOnlyAffectedKeys(newData, existingData, updateKeys()) &&
              hasAllRequiredAffectedKeys(newData, existingData, updateRequiredKeys()) &&
              isUserOwner() && isOwner(existingData, 'userId') &&
              newData.createdAt == existingData.createdAt &&
              newData.userId == existingData.userId &&
              validTimestamp(newData.updatedAt) &&
              hasValidOptionalString(newData, 'name', getLengthLimit('item.name')) &&
              hasValidOptionalString(newData, 'description', getLengthLimit('item.description'))
            );
        }

        allow get: if
          environmentAccessAllowed()
          && folderMatchesConfig()
          && (isAdmin() || isUserOwner());

        allow list: if
          environmentAccessAllowed()
          && folderMatchesConfig()
          && (isAdmin() || isUserOwner());

        allow create: if
          environmentAccessAllowed()
          && folderMatchesConfig()
          && validCreate(request.resource.data)
          && (isAdmin() || isUserOwner());

        allow update: if
          environmentAccessAllowed()
          && folderMatchesConfig()
          && validUpdate(request.resource.data, resource.data)
          && (isAdmin() || isUserOwner());

        allow delete: if
          environmentAccessAllowed()
          && folderMatchesConfig()
          && (isAdmin() || isUserOwner());
      }

      // Private wishlists' wishes
      match /private/users/{userId}/wishlists/{wishlistId}/wishes/{wishId} {
        function isUserOwner() {
          return isOwner({'userId': userId}, 'userId');
        }
        function getLengthLimit(field) {
          return (field == 'item.name') ? 100 :
                (field == 'item.description') ? 1000 : 0;
        }
        function createKeys() {
          return ['name', 'nameLowercase', 'nameTokens', 'createdAt', 'updatedAt', 'description', 'tags', 'metadata', 'userId', 'wishlistId'];
        }
        function createRequiredKeys() {
          return ['name', 'nameLowercase', 'nameTokens', 'createdAt', 'userId', 'wishlistId'];
        }
        function validCreate(data) {
          return 
            (
              isAuthenticated() &&
              hasOnlyValidKeys(data, createKeys()) &&
              hasAllRequiredKeys(data, createRequiredKeys()) &&
              isUserOwner() && isOwner(data, 'userId') &&
              validString(data.name, getLengthLimit('item.name')) &&
              validTimestamp(data.createdAt) &&
              hasValidOptionalString(data, 'description', getLengthLimit('item.description'))
            );
        }
        function updateKeys() {
          return ['name', 'nameLowercase', 'nameTokens', 'updatedAt', 'description', 'tags', 'metadata', 'userId', 'wishlistId'];
        }
        function updateRequiredKeys() {
          return ['updatedAt'];
        }
        function validUpdate(newData, existingData) {
          return 
            (
              isAuthenticated() &&
              existingData != null &&
              hasOnlyAffectedKeys(newData, existingData, updateKeys()) &&
              hasAllRequiredAffectedKeys(newData, existingData, updateRequiredKeys()) &&
              isUserOwner() && isOwner(existingData, 'userId') &&
              newData.createdAt == existingData.createdAt &&
              newData.userId == existingData.userId &&
              validTimestamp(newData.updatedAt) &&
              hasValidOptionalString(newData, 'name', getLengthLimit('item.name')) &&
              hasValidOptionalString(newData, 'description', getLengthLimit('item.description'))
            );
        }

        allow get: if
          environmentAccessAllowed()
          && folderMatchesConfig()
          && (isAdmin() || isUserOwner());

        allow list: if
          environmentAccessAllowed()
          && folderMatchesConfig()
          && (isAdmin() || isUserOwner());

        allow create: if
          environmentAccessAllowed()
          && folderMatchesConfig()
          && validCreate(request.resource.data)
          && (isAdmin() || isUserOwner());

        allow update: if
          environmentAccessAllowed()
          && folderMatchesConfig()
          && validUpdate(request.resource.data, resource.data)
          && (isAdmin() || isUserOwner());

        allow delete: if
          environmentAccessAllowed()
          && folderMatchesConfig()
          && (isAdmin() || isUserOwner());
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
