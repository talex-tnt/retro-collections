{
  "scripts": {
    "login": "firebase login",
    "deploy:firestore": "dotenv -e .env -- sh -c 'firebase deploy --only firestore --project=$ENV'",
    "deploy:indexes": "dotenv -e .env -- sh -c 'firebase deploy --only firestore:indexes --project=$ENV'",
    "deploy": "dotenv -e .env -- sh -c 'echo $ENV && firebase deploy --project=$ENV'",
    "deploy:ci": "firebase deploy --project $ENV",
    "db:init:main": "dotenv -e .env -- node db-scripts/init-main-db.mjs",
    "db:backfill:items:is-public": "dotenv -e .env -- node db-scripts/backfill-items-is-public.mjs",
    "db:migrate:whishes-to-wishes": "dotenv -e .env -- node db-scripts/migrate-whishes-to-wishes.mjs",
    "db:backfill:items:created-at-to-updated-at": "dotenv -e .env -- node db-scripts/backfill-items-created-at-to-updated-at.mjs",
    "db:set-admin": "node db-scripts/set-admin.mjs",
    "db:usage:storage": "dotenv -e .env -- node db-scripts/db-storage-usage.js",
    "db:deep-dump": "dotenv -e .env -- node db-scripts/db-deep-dump.js",
    "db:debug:list-indexes": "dotenv -e .env -- node db-scripts/list-indexes.js",
    "db:debug:test-query": "dotenv -e .env -- node db-scripts/test-query.js",
    "list:indexes": "dotenv -e .env -- sh -c 'firebase firestore:indexes --project=$ENV'",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:rules": "node --test tests/*-firestore.rules.*.test.mjs",
    "test:rules:emulator:all": "RULES_TARGET=emulator firebase emulators:exec --only auth,firestore 'node --test tests/*-firestore.rules.*.test.mjs'",
    "test:rules:emulator:users": "RULES_TARGET=emulator firebase emulators:exec --only auth,firestore 'node --test tests/0-firestore.rules.users.test.mjs'",
    "test:rules:emulator:authorized-users": "RULES_TARGET=emulator firebase emulators:exec --only auth,firestore 'node --test tests/1-firestore.rules.authorized-users.test.mjs'",
    "test:rules:emulator:items": "RULES_TARGET=emulator firebase emulators:exec --only auth,firestore 'node --test tests/2-firestore.rules.users.items.test.mjs'",
    "test:rules:emulator:misc": "RULES_TARGET=emulator firebase emulators:exec --only auth,firestore 'node --test tests/3-firestore.rules.misc.test.mjs'",
    "test:rules:emulator:nickname-index": "RULES_TARGET=emulator firebase emulators:exec --only auth,firestore 'node --test tests/4-firestore.rules.nickname-index.test.mjs'",
    "test:rules:live:all": "RULES_TARGET=live ENV=dev node --test tests/*-firestore.rules.*.test.mjs",
    "test:rules:live:users": "RULES_TARGET=live ENV=dev node --test tests/0-firestore.rules.users.test.mjs",
    "test:rules:live:authorized-users": "RULES_TARGET=live ENV=dev node --test tests/1-firestore.rules.authorized-users.test.mjs",
    "test:rules:live:items": "RULES_TARGET=live ENV=dev node --test tests/2-firestore.rules.users.items.test.mjs",
    "test:rules:live:misc": "RULES_TARGET=live ENV=dev node --test tests/3-firestore.rules.misc.test.mjs",
    "test:rules:live:nickname-index": "RULES_TARGET=live ENV=dev node --test tests/4-firestore.rules.nickname-index.test.mjs"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "firebase": "^12.12.1",
    "firebase-admin": "^13.8.0",
    "firebase-tools": "^15.17.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "dotenv-cli": "^11.0.0",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "globals": "^17.6.0",
    "prettier": "^3.8.3"
  }
}
